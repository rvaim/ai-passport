{
  "id": "system.settings",
  "name": "设置",
  "author": "FoloToy",
  "version": 5,
  "host_api": 5,
  "permissions": ["settings"],
  "state_slots": 7,
  "templates": {
    "render": [
      ["ui_screen", "设置"],
      ["ui_list_row", 0, "\uf06e", "亮度", "percent", 1, 0, true],
      ["ui_list_row", 1, "\uf028", "音量", "percent", 2, 0, true],
      ["ui_list_row", 2, "\uf0f3", "按键音", "toggle", 3, 0, true],
      ["ui_list_row", 3, "\uf011", "自动息屏", "duration", 4, 0, true],
      ["ui_list_row", 4, "\uf043", "主题", "theme", 5, 0, true],
      ["ui_list_row", 5, "\uf287", "设备", "text", "信息", 0, true],
      ["ui_action_bar", "选择", "修改", "返回"],
      ["ui_commit"],
      ["end"]
    ]
  },
  "handlers": {
    "start": [
      ["push", 0],
      ["store_state", 0],
      ["push", 0],
      ["store_state", 6],
      ["setting_load", 0, 1],
      ["setting_load", 1, 2],
      ["setting_load", 2, 3],
      ["setting_load", 3, 4],
      ["setting_load", 4, 5],
      ["include", "render"]
    ],
    "up": [
      ["load_state", 6],
      ["jnz", "up_done"],
      ["load_state", 0],
      ["push", 5],
      ["add"],
      ["push", 6],
      ["mod"],
      ["store_state", 0],
      ["include", "render"],
      ["label", "up_done"],
      ["end"]
    ],
    "down": [
      ["load_state", 6],
      ["jnz", "down_done"],
      ["load_state", 0],
      ["push", 1],
      ["add"],
      ["push", 6],
      ["mod"],
      ["store_state", 0],
      ["include", "render"],
      ["label", "down_done"],
      ["end"]
    ],
    "ok": [
      ["load_state", 6],
      ["jz", "settings_mode"],
      ["push", 0],
      ["store_state", 6],
      ["jump", "render_settings"],

      ["label", "settings_mode"],
      ["load_state", 0],
      ["push", 5],
      ["eq"],
      ["jz", "change_theme"],
      ["push", 1],
      ["store_state", 6],
      ["device_info"],
      ["end"],

      ["label", "change_theme"],
      ["load_state", 0],
      ["push", 4],
      ["eq"],
      ["jz", "change_brightness"],
      ["theme_next", 5],
      ["jump", "change_done"],

      ["label", "change_brightness"],
      ["load_state", 0],
      ["push", 0],
      ["eq"],
      ["jz", "change_volume"],
      ["load_state", 1],
      ["push", 10],
      ["add"],
      ["dup"],
      ["push", 100],
      ["gt"],
      ["jz", "brightness_store"],
      ["drop"],
      ["push", 10],
      ["label", "brightness_store"],
      ["store_state", 1],
      ["setting_save", 0, 1],
      ["jump", "change_done"],

      ["label", "change_volume"],
      ["load_state", 0],
      ["push", 1],
      ["eq"],
      ["jz", "change_key_sound"],
      ["load_state", 2],
      ["push", 10],
      ["add"],
      ["dup"],
      ["push", 100],
      ["gt"],
      ["jz", "volume_store"],
      ["drop"],
      ["push", 0],
      ["label", "volume_store"],
      ["store_state", 2],
      ["setting_save", 1, 2],
      ["jump", "change_done"],

      ["label", "change_key_sound"],
      ["load_state", 0],
      ["push", 2],
      ["eq"],
      ["jz", "change_timeout"],
      ["load_state", 3],
      ["not"],
      ["store_state", 3],
      ["setting_save", 2, 3],
      ["jump", "change_done"],

      ["label", "change_timeout"],
      ["load_state", 4],
      ["push", 0],
      ["eq"],
      ["jz", "timeout_from_30"],
      ["push", 30],
      ["jump", "timeout_store"],
      ["label", "timeout_from_30"],
      ["load_state", 4],
      ["push", 30],
      ["eq"],
      ["jz", "timeout_from_60"],
      ["push", 60],
      ["jump", "timeout_store"],
      ["label", "timeout_from_60"],
      ["load_state", 4],
      ["push", 60],
      ["eq"],
      ["jz", "timeout_from_180"],
      ["push", 180],
      ["jump", "timeout_store"],
      ["label", "timeout_from_180"],
      ["load_state", 4],
      ["push", 180],
      ["eq"],
      ["jz", "timeout_from_300"],
      ["push", 300],
      ["jump", "timeout_store"],
      ["label", "timeout_from_300"],
      ["push", 0],
      ["label", "timeout_store"],
      ["store_state", 4],
      ["setting_save", 3, 4],

      ["label", "change_done"],
      ["label", "render_settings"],
      ["include", "render"]
    ],
    "back": [
      ["load_state", 6],
      ["jz", "leave_settings"],
      ["push", 0],
      ["store_state", 6],
      ["include", "render"],
      ["label", "leave_settings"],
      ["exit"],
      ["end"]
    ]
  }
}
