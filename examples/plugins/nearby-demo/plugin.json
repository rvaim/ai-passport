{
  "id": "dev.passport.nearby-demo",
  "name": "近场通信",
  "author": "Passport",
  "version": 1,
  "host_api": 5,
  "permissions": [
    "nearby"
  ],
  "state_slots": 8,
  "templates": {
    "render": [
      ["ui_screen", "近场通信"],
      ["ui_value_card", "连接状态", "integer", 0, ""],
      ["ui_list_row", 0, "", "最近事件", "integer", 1, 7, true],
      ["ui_list_row", 1, "", "数据大小", "integer", 4, 7, true],
      ["ui_action_bar", "", "发送问候", "返回"],
      ["ui_commit"],
      ["end"]
    ]
  },
  "handlers": {
    "start": [
      ["buffer_alloc", 128, 5],
      ["buffer_append_text", 5, "来自 Passport 的问候"],
      ["nearby_acquire"],
      ["include", "render"]
    ],
    "ok": [
      ["nearby_send", 5, 6],
      ["end"]
    ],
    "back": [
      ["nearby_release"],
      ["buffer_release", 5],
      ["exit"],
      ["end"]
    ],
    "nearby": [
      ["event_load", "type", 1],
      ["event_load", "id", 2],
      ["event_load", "handle", 3],
      ["event_load", "value", 4],
      ["load_state", 1],
      ["push", 1],
      ["eq"],
      ["jnz", "state"],
      ["load_state", 1],
      ["push", 2],
      ["eq"],
      ["jnz", "release_data"],
      ["load_state", 1],
      ["push", 4],
      ["eq"],
      ["jnz", "accept_blob"],
      ["load_state", 1],
      ["push", 6],
      ["eq"],
      ["jnz", "release_data"],
      ["jump", "render"],
      ["label", "state"],
      ["load_state", 4],
      ["store_state", 0],
      ["jump", "render"],
      ["label", "release_data"],
      ["buffer_release", 3],
      ["jump", "render"],
      ["label", "accept_blob"],
      ["buffer_release", 3],
      ["nearby_blob_accept", 2],
      ["label", "render"],
      ["include", "render"]
    ]
  }
}
